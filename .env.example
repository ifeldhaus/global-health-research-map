# Anthropic API key — used by pipeline/02_topic_classify.py, 03_methods_classify.py, 06_study_country.py
ANTHROPIC_API_KEY=

# Contact email sent to the OpenAlex API (polite pool) — used by 01_corpus_pull.py, 04_funder_normalize.py
OPENALEX_EMAIL=

# Optional: genderize.io API key for higher rate limits — used by 05_gender_infer.py
GENDERIZE_API_KEY=

# Optional: override the classification model (default: claude-haiku-4-5)
# CLASSIFIER_MODEL=claude-sonnet-5
